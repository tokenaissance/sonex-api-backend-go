syntax = "v1"

import "./api/sonex.api"
import "./api/pre_deposit.api"
import "./api/xpool.api"
import "./api/farm.api"
import "./api/acs.api"
import "./api/badge.api"

/*
Global Module
*/
type MetaRequest {}

type ChainSyncPrograss {
	ChainId   int64  `json:"chainId"`
	Height    int64  `json:"height"`
	UpdatedAt string `json:"updateAt"`
}

type MetaResponse {
	ChainSyncPrograsses []ChainSyncPrograss `json:"chainSyncPrograsses"`
}

type ReplayRequest {
	ChainId int64   `json:"chainId"`
	Start   uint64  `json:"start"`
	End     *uint64 `json:"end,optional"`
}

type ReplayResponse {}

service sonex_api_backend_go {
	@handler MetaHandler
	get /meta (MetaRequest) returns (MetaResponse)

	@handler ReplayHandler
	post /replay (ReplayRequest) returns (ReplayResponse)
}

