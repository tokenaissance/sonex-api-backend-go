/*
XPool Module
*/
type XPoolPoolListRequest {
	Name string `path:"name,options=you|me"`
}

type XPoolPoolListResponse {
	Message string `json:"message"`
}

type XPoolPoolStatsRequest {
	Name string `path:"name,options=you|me"`
}

type XPoolPoolStatsResponse {
	Message string `json:"message"`
}

@server (
	prefix: /x_pool
	group:  x_pool
)
service sonex_api_backend_go {
	@handler XPoolPoolListHandler
	get /pool/list (XPoolPoolListRequest) returns (XPoolPoolListResponse)

	@handler XPoolPoolStatsHandler
	get /pool/stats (XPoolPoolStatsRequest) returns (XPoolPoolStatsResponse)
}

