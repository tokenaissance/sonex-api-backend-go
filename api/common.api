syntax = "v1"

type Token {
	Address  string `json:"address"`
	Symbol   string `json:"symbol"`
	Decimals int64  `json:"decimals"`
	Price    string `json:"price"`
}

type Pool {
	Address string `json:"address"`
	Token0  Token  `json:"token0"`
	Token1  Token  `json:"token1"`
	Fee     string `json:"fee"`
}