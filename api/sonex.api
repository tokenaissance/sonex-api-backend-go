}

// 前端拿到这个值,加 % 后显示
type VolumeDetailsRecord {
	VolumeRatio     float64 `json:"volumeratio"` // 跟过去一天的volume最后一组24H的相比，相比的,是增加还是减弱 ,保留两位精度
	VolumeUsd     	float64 `json:"volumeusd"` 
	CreatedAt       int64   `json:"createdat"`
}

type GalxeAddLiquidityRequest {
	Address string `form:"address"`
}

type GalxeAddLiquidityResponse {
	IsAddLiquidityOrNot    bool                `json:"isAddLiquidityOrNot"`
}


//  sonex volumetotal request
type SonexVolumeKlineRequest {
	ChainRequest
}

// sonex volumetotal response  
type SonexVolumeKlineResponse {
	Records []UsdCreatedRecord `json:"records"`
}

//  sonex tvl kline request 
type SonexTvlKlineRequest {
	ChainRequest
}

//  sonex tvl kline response 
type SonexTvlKlineResponse {
	Records []UsdCreatedRecord `json:"records"`
}

type UsdCreatedRecord {
	UsdtValue     	 string `json:"usdt_value"` 
	Createtime       int64   `json:"createtime"`
}

@server (
	prefix: /sonex
	group:  sonex
)
service sonex_api_backend_go {
	@handler SonexTokenPriceHandler
	get /token/price (TokenPriceRequest) returns (TokenPriceResponse)

	@handler SonexTokenQuoteHandler
	get /token/quote (TokenQuoteRequest) returns (TokenQuoteResponse)

	@handler TransactionsHandler
	get /transactions (TransactionsRequest) returns ([]TransactionsResponse_Transaction)

	@handler TokensHandler
	get /tokens (TokensRequest) returns ([]TokensResponse_Token)

	@handler SonexTokenTopHandler
	get /tokens/top returns (TokenTopResponse)

	@handler SonexPoolListHandler
	get /pools (PoolsRequest) returns ([]PoolsResponse_Pool)

	@handler SonexPositionsHandler
	get /pools/positions (PositionsRequest) returns (PositionsResponse)

	@handler SonexPositionHandler
	get /pools/position/:tokenId (PositionRequest) returns (PositionResponse)

	@handler SonexTokensInfoHandler
	get /tokens/info/:address (TokensInfoRequest)  returns (TokenInfoResponse)

	@handler SonexPoolInfoHandler
	get /pools/info/:address (PoolInfoRequest) returns (PoolInfoResponse)

	@handler SonexPoolInfoKlineRequest
	get /pools/kline/:address (SonexPoolInfoKlineRequest) returns (SonexPoolInfoKlineResponse)

	@handler SonexPositionValuesHandler
	get /pools/position_values (PositionValuesRequest) returns (PositionValuesResponse)

	@handler SonexSwapVolumeHandler
	get /swaps/volume (SwapVolumeRequest) returns (SwapVolumeResponse)

	@handler TokensKlineHandler
	get /tokens/kline (SonexTokenKlineRequest) returns (SonexTokenKlineResponse)

	@handler SonexPortfolioHandler
	get /portfolio (PortfolioRequest) returns (PortfolioResponse)

	@handler SonexGalxeswapHandler
	get /galxeswap (GalxeSwapRequest) returns (GalxeSwapResponse)

	@handler SonexGalxeTgidHandler
	get /galxetgid (GalxeTgIdRequest) returns (GalxeTgIdResponse)

	@handler SonexGalxeAddliquidityHandler
	get /galxeaddliquidity (GalxeAddLiquidityRequest) returns (GalxeAddLiquidityResponse)

	@handler SonexVolumeKlineHandler
	get /volumekline (SonexVolumeKlineRequest) returns (SonexVolumeKlineResponse)

	@handler SonexTvlKlineHandler
	get /tvlkline (SonexTvlKlineRequest) returns (SonexTvlKlineResponse)
}