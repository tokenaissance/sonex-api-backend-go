syntax = "v1"

/*
Sonex Module
*/
type TokenPriceRequest {
	ChainId        int64   `form:"chainId"`
	Token          string  `form:"token"`
	IsCache        bool    `form:"isCache,optional,default=true"`
	WantStablecoin *string `form:"wantStablecoin,optional"`
}

type TokenPriceResponse_Price_Pool {
	Address string `json:"address"`
	Token0  string `json:"token0"`
	Token1  string `json:"token1"`
	Fee     int64  `json:"fee"`
}

type TokenPriceResponse_Price {
	Stablecoin string                          `json:"stablecoin"`
	Router     []TokenPriceResponse_Price_Pool `json:"router"`
	Value      string                          `json:"value"`
}

type TokenPriceResponse {
	BasePrice *TokenPriceResponse_Price  `json:"bestPrice"`
	Prices    []TokenPriceResponse_Price `json:"prices"`
}

type TokenQuoteRequest {
	ChainId    int64  `form:"chainId"`
	From       string `form:"from"`
	To         string `form:"to"`
	Type       string `form:"type,options=INPUT|OUTPUT"`
	Amount     string `form:"amount"`
	Stablecoin string `form:"stablecoin"`
}

type TokenQuoteResponse_Router_Pool {
	Address string `json:"address"`
	Token0  string `json:"token0"`
	Token1  string `json:"token1"`
	Fee     int64  `json:"fee"`
}

type TokenQuoteResponse_Router {
	TokenIn                     string                           `json:"tokenIn"`
	TokenOut                    string                           `json:"tokenOut"`
	AmountIn                    string                           `json:"amountIn"`
	AmountOut                   string                           `json:"amountOut"`
	Stablecoin                  string                           `json:"stablecoin"`
	PriceUSDIn                  string                           `json:"priceUsdIn"`
	PriceUSDOut                 string                           `json:"priceUsdOut"`
	Router                      []TokenQuoteResponse_Router_Pool `json:"router"`
	Path                        string                           `json:"path"`
	SqrtPriceX96AfterList       []string                         `json:"sqrtPriceX96AfterList"`
	InitializedTicksCrossedList []int64                          `json:"initializedTicksCrossedList"`
	GasEstimate                 string                           `json:"gasEstimate"`
	PriceImpact                 string                           `json:"priceImpact"`
}

type TokenQuoteResponse {
	SwapRouter string                      `json:"swapRouter"`
	BestRouter *TokenQuoteResponse_Router  `json:"bestRouter"`
	Routers    []TokenQuoteResponse_Router `json:"routers"`
}

type TokenListRequest {
	Order   string `form:"order,default=ASC"` // Sorting order, default is "ASC"
	Page    int64  `form:"page,default=1"`    // Current page number, default is 1
	Take    int64  `form:"take,default=10"`   // Number of items per page, default is 10
	ChainId int64  `form:"chainId,default=1946,optional"`
}

type PaginationMeta {
	Page            int  `json:"page"`
	Take            int  `json:"take"`
	ItemCount       int  `json:"itemCount"`
	PageCount       int  `json:"pageCount"`
	HasPreviousPage bool `json:"hasPreviousPage"`
	HasNextPage     bool `json:"hasNextPage"`
}

type TokenListResponse {
	Code    int                  `json:"code"`
	Data    []*Token_TokenDetail `json:"data"`
	Meta    *PaginationMeta      `json:"meta"`
	Message string               `json:"message"`
}

type TokensRequest {
	Order   string `form:"order,default=ASC"` // Sorting order, default is "ASC"
	Page    int64  `form:"page,default=1"`    // Current page number, default is 1
	Take    int64  `form:"take,default=10"`   // Number of items per page, default is 10
	ChainId int64  `form:"chainId,default=1946,optional"`
}

type TokensResponse {
	Code    int                  `json:"code"`
	Data    []*Token_TokenDetail `json:"data"`
	Meta    *PaginationMeta      `json:"meta"`
	Message string               `json:"message"`
}

type SonexTokenPricesRequest {
	Name string `path:"name,options=you|me"`
}

type SonexTokenPricesResponse {
	Message string `json:"message"`
}

type PoolsRequest {
	Order         string `form:"order,default=ASC"`
	Page          int64  `form:"page,default=1"`
	Take          int64  `form:"take,default=10"`
	ChainId       int64  `form:"chainId,default=1946,optional"`
	Keywords      string `form:"keywords,optional"`
	Token0Address string `form:"token0Address,optional"`
	Token1Address string `form:"token1Address,optional"`
}

type Token_Social {
	Github   string `json:"github"`
	Reddit   string `json:"reddit"`
	Discord  string `json:"discord"`
	Twitter  string `json:"twitter"`
	Bitclout string `json:"bitclout"`
	Telegram string `json:"telegram"`
}

type PoolsResponse_TokenAdditional {
	Audits      string       `json:"audits"`
	Social      Token_Social `json:"social"`
	Website     string       `json:"website"`
	Whitepaper  string       `json:"whitepaper"`
	Description string       `json:"description"`
}

type PoolsResponse_Token {
	Address    string                        `json:"address"`
	Symbol     string                        `json:"symbol"`
	Name       string                        `json:"name"`
	Decimals   int                           `json:"decimals"`
	Logo       string                        `json:"logo"`
	Additional PoolsResponse_TokenAdditional `json:"additional"`
}

type PoolsResponse_Volume {
	Date         int64  `json:"date"`
	Address      string `json:"address"`
	Token0Price  string `json:"token0Price"`
	Token1Price  string `json:"token1Price"`
	VolumeToken0 string `json:"volumeToken0"`
	VolumeToken1 string `json:"volumeToken1"`
	Volume       string `json:"volume"`
}

type PoolPositionData {
	EventPool    string `json:"eventPool"`
	EventToken0  string `json:"eventToken0"`
	EventToken1  string `json:"eventToken1"`
	EventTokenId int64  `json:"eventTokenId"`
}

type PoolsResponse_Pool {
	Id                 string              `json:"id"`
	Address            string              `json:"address"`
	FeeTier            int64               `json:"feeTier"`
	Liquidity          string              `json:"liquidity"`
	Token0             PoolsResponse_Token `json:"token0"`
	Token1             PoolsResponse_Token `json:"token1"`
	Token0Price        string              `json:"token0Price"`
	Token1Price        string              `json:"token1Price"`
	Tick               string              `json:"tick"`
	Volume             string              `json:"volume"`
	TvlUSD             string              `json:"tvlUSD"`
	Token0Balance      string              `json:"token0Balance"`
	Token1Balance      string              `json:"token1Balance"`
	Yield24h           string              `json:"yield24h"`
	Price0             string              `json:"price0"`
	Price1             string              `json:"price1"`
	Stablecoin         string              `json:"stablecoin"`
	StablecoinDecimals int64               `json:"decimals"`
}

type PoolsResponse {
	Code    int                   `json:"code"`
	Data    []*PoolsResponse_Pool `json:"data"`
	Meta    *PaginationMeta       `json:"meta"`
	Message string                `json:"message"`
}

type TokenTopResponse {
	Code    int                  `json:"code"`
	Data    []*Token_TokenDetail `json:"data"`
	Message string               `json:"message"`
}

type PriceComparisonResult {
	Comparison string  `json:"comparison"`
	Percentage float64 `json:"percentage"`
}

type Token_Kline {
	Price     string `json:"price"`
	TimeStamp int64  `json:"timeStamp"`
}

type Token_TokenDetail {
	Address             string                `json:"address"`
	Symbol              string                `json:"symbol"`
	Name                string                `json:"name"`
	Decimals            int                   `json:"decimals"`
	Logo                string                `json:"logo"`
	Pools               []*Token_PoolDetail   `json:"pools"`
	Volume              string                `json:"volume"`
	Fdv                 string                `json:"fdv"`
	Price               string                `json:"price"`
	Kline               []*Token_Kline        `json:"kline"`
	HourPriceComparison PriceComparisonResult `json:"hourPriceComparison"`
	DayPriceComparison  PriceComparisonResult `json:"dayPriceComparison"`
}

type Token_PoolDetail {
	ID          int64           `json:"id"`
	Address     string          `json:"address"`
	FeeTier     int             `json:"feeTier"`
	Liquidity   string          `json:"liquidity"`
	Token0      Token_TokenInfo `json:"token0"`
	Token1      Token_TokenInfo `json:"token1"`
	Token0Price string          `json:"token0Price"`
	Token1Price string          `json:"token1Price"`
	Tick        string          `json:"tick"`
	Volume      interface{}     `json:"volume"`
}

type Token_TokenInfo {
	Address    string      `json:"address"`
	Symbol     string      `json:"symbol"`
	Name       string      `json:"name"`
	Decimals   int         `json:"decimals"`
	Logo       string      `json:"logo"`
	Additional interface{} `json:"additional"`
}

type PositionResponse {
	Position *Position `json:"position"`
}

type NftDataResponse_Data {
	Amount0         float64          `json:"amount0"`
	Amount1         float64          `json:"amount1"`
	Amount0Price    float64          `json:"amount0Price"`
	Amount1Price    float64          `json:"amount1Price"`
	TickUpper       string           `json:"tickUpper"`
	TickLower       string           `json:"tickLower"`
	NftId           int              `json:"nftId"`
	UncollectedFees float64          `json:"uncollectedFees"`
	Pnl30d          string           `json:"pnl30d"`
	Owner           string           `json:"owner"`
	Pool            Token_PoolDetail `json:"pool"`
	PositionAge     int              `json:"positionAge"`
	Invested        Invested         `json:"invested"`
	Withdrawn       Withdrawn        `json:"withdrawn"`
	Fees            Fees             `json:"fees"`
	Origin          string           `json:"origin"`
	Fee             int              `json:"fee"`
	Token0          string           `json:"token0"`
	Token1          string           `json:"token1"`
	TokensOwed0     float64          `json:"tokensOwed0"`
	TokensOwed1     float64          `json:"tokensOwed1"`
	Liquidity       string           `json:"liquidity"`
	Price           string           `json:"price"`
	Token0Price     string           `json:"token0Price"`
	Token1Price     string           `json:"token1Price"`
	PoolAddress     string           `json:"poolAddress"`
	IsNative        int              `json:"isNative"`
	IsClosed        bool             `json:"isClosed"`
	Decimals0       int              `json:"decimals0"`
	Decimals1       int              `json:"decimals1"`
	Ratio           int              `json:"ratio"`
	IsNegative      bool             `json:"isNegative"`
	AmountPrice0    string           `json:"amountPrice0"`
	AmountPrice1    string           `json:"amountPrice1"`
}

type Invested {
	InvestedAmount0 string `json:"investedAmount0"`
	InvestedAmount1 string `json:"investedAmount1"`
}

type Withdrawn {
	WithdrawnAmount0 string `json:"withdrawnAmount0"`
	WithdrawnAmount1 string `json:"withdrawnAmount1"`
}

type Fees {
	FeeAmount0 string `json:"feeAmount0"`
	FeeAmount1 string `json:"feeAmount1"`
}

type AggregatedAmounts {
	TotalAmount0 float64 `json:"totalAmount0"`
	TotalAmount1 float64 `json:"totalAmount1"`
}

type PositionRequest {
	TokenId int64 `path:"tokenId"`
	ChainId int64 `form:"chainId,default=1946,optional"`
}

type SwapEventRequest {
	Order       string `form:"order,default=ASC"` // Sorting order, default is "ASC"
	Page        int64  `form:"page,default=1"`    // Current page number, default is 1
	Take        int64  `form:"take,default=10"`   // Number of items per page, default is 10
	Address     string `form:"address,optional"`
	PoolAddress string `form:"poolAddress,optional"`
	Token       string `form:"token,optional"`
	Token0      string `form:"token0,optional"`
	Token1      string `form:"token1,optional"`
	ChainId     int64  `form:"chainId,default=1946,optional"`
}

type SwapEvent {
	ID        int64            `json:"id"`
	Address   string           `json:"address"`
	Token0    Token_TokenInfo  `json:"token0"`
	Token1    Token_TokenInfo  `json:"token1"`
	Pool      Token_PoolDetail `json:"pool"`
	Hash      string           `json:"hash"`
	Amount0   float64          `json:"amount0"`
	Amount1   float64          `json:"amount1"`
	Usd       float64          `json:"usd"`
	CreatedAt string           `json:"createdAt"`
}

type SwapEventResponse {
	Code    int             `json:"code"`
	Data    []*SwapEvent    `json:"data"`
	Meta    *PaginationMeta `json:"meta"`
	Message string          `json:"message"`
}

type SwapVolumeRequest {
	PoolAddress string `form:"poolAddress"` // Pool address
	Interval    string `form:"interval,optional,default=1d,options=1d|1w|1m"`
	Address     string `form:"address,optional"`
	Token       string `form:"token,optional"`
	Token0      string `form:"token0,optional"`
	Token1      string `form:"token1,optional"`
	ChainId     int64  `form:"chainId,default=1946,optional"`
}

type SwapVolume {
	Timestamp int64   `json:"timestamp"`
	Value     float64 `json:"value"`
	Amount    float64 `json:"amount"`
	Amount0   float64 `json:"amount0"`
	Amount1   float64 `json:"amount1"`
}

type SwapVolumeResponse {
	Volumes []SwapVolume `json:"volumes"`
}

type TokenVolume {
	Address string  `json:"address"`
	Amounts float64 `json:"amounts"`
}

type PoolVolume {
	Address  string  `json:"address"`
	Amounts0 float64 `json:"amounts0"`
	Amounts1 float64 `json:"amounts1"`
}

type PositionValuesRequest {
	Address  string `form:"address"`
	Interval string `form:"interval,optional,default=1d"`
	ChainId  int64  `form:"chainId,default=1946,optional"`
}

type Position {
	TokenID       int64            `json:"tokenId"`
	Position      float64          `json:"position"`
	ClaimableFees float64          `json:"claimableFees"`
	IsClosed      bool             `json:"isClosed"`
	TickUpper     string           `json:"tickUpper"`
	TickLower     string           `json:"tickLower"`
	PNL           float64          `json:"pnl"`
	IsNegative    bool             `json:"isNegative"`
	Origin        string           `json:"origin"`
	Pool          Token_PoolDetail `json:"pool"`
	PositionAge   int              `json:"positionAge"`
	Amount0       float64          `json:"amount0"`
	Amount1       float64          `json:"amount1"`
	Price0        float64          `json:"price0"`
	Price1        float64          `json:"price1"`
	UnclaimedFee0 float64          `json:"unclaimedFee0"`
	UnclaimedFee1 float64          `json:"unclaimedFee1"`
}

type PositionValueRecord {
	TimeStamp int64 `json:"timeStamp"`
	PositionValue float64 `json:"positionValue"`
}

type PositionValuesResponse {
	Pnl           	float64 `json:"pnl"`
	PositionValues  []*PositionValueRecord `json:"positionValues"`
	TotalPosition 	float64 `json:"totalPosition"`
}

type MyPositionRequest {
	Address    string `form:"address"`
	FilterType string `form:"filterType,optional,default=none"`
}

type MyPositionResponse {
	Position []*Position `json:"position"`
}

type SonexTokenKlineRequest {
	Address  string `form:"address"`
	Interval string `form:"interval,options=1h|1d|1w|1m|1y"`
}

type SonexTokenPriceRecord {
	Id           int64  `json:"id"`
	TokenSymbol  string `json:"tokenSymbol"`
	TokenAddress string `json:"tokenAddress"`
	Price        string `json:"price"`
	CreatedAt    string `json:"createdAt"`
	TimeStamp    int64  `json:"timeStamp"`
}

type SonexTokenKlineResponse {
	Records []SonexTokenPriceRecord `json:"records"`
}

@server (
	prefix: /sonex
	group:  sonex
)
service sonex_api_backend_go {
	@handler SonexTokenPriceHandler
	get /token/price (TokenPriceRequest) returns (TokenPriceResponse)

	@handler SonexTokenQuoteHandler
	get /token/quote (TokenQuoteRequest) returns (TokenQuoteResponse)

	@handler SonexTokenListHandler
	get /tokens/list (TokenListRequest) returns (TokenListResponse)

	@handler SonexTokensHandler
	get /tokens (TokenListRequest) returns (TokensResponse)

	@handler SonexTokenTopHandler
	get /tokens/top returns (TokenTopResponse)

	@handler SonexPoolListHandler
	get /pools (PoolsRequest) returns (PoolsResponse)

	@handler SonexMyPositionHandler
	get /pools/my_position (MyPositionRequest) returns (MyPositionResponse)

	@handler SonexPositionHandler
	get /pools/position/:tokenId (PositionRequest) returns (PositionResponse)

	@handler SonexPositionsHandler
	get /pools/position_values (PositionValuesRequest) returns (PositionValuesResponse)

	@handler SonexSwapHandler
	get /swaps (SwapEventRequest) returns (SwapEventResponse)

	@handler SonexSwapVolumeHandler
	get /swaps/volume (SwapVolumeRequest) returns (SwapVolumeResponse)

	@handler TokensKlineHandler
	get /tokens/kline (SonexTokenKlineRequest) returns (SonexTokenKlineResponse)
}