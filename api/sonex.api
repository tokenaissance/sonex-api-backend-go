}

type PoolsResponse_Token {
	Address    string                        `json:"address"`
	Symbol     string                        `json:"symbol"`
	Name       string                        `json:"name"`
	Decimals   int                           `json:"decimals"`
	Logo       string                        `json:"logo"`
	Additional PoolsResponse_TokenAdditional `json:"additional"`
}

type PoolsResponse_Volume {
	Date         int64  `json:"date"`
	Address      string `json:"address"`
	Token0Price  string `json:"token0Price"`
	Token1Price  string `json:"token1Price"`
	VolumeToken0 string `json:"volumeToken0"`
	VolumeToken1 string `json:"volumeToken1"`
	Volume       string `json:"volume"`
}

type PoolPositionData {
	EventPool    string `json:"eventPool"`
	EventToken0  string `json:"eventToken0"`
	EventToken1  string `json:"eventToken1"`
	EventTokenId int64  `json:"eventTokenId"`
}

type PoolsResponse_Pool {
	Id                 string              `json:"id"`
	Address            string              `json:"address"`
	FeeTier            int64               `json:"feeTier"`
	Liquidity          string              `json:"liquidity"`
	Token0             PoolsResponse_Token `json:"token0"`
	Token1             PoolsResponse_Token `json:"token1"`
	Token0Price        *Token_TokenPrice   `json:"token0Price"`
	Token1Price        *Token_TokenPrice   `json:"token1Price"`
	Tick               string              `json:"tick"`
	Volume             string              `json:"volume"`
	TvlUSD             string              `json:"tvlUSD"`
	Token0Balance      string              `json:"token0Balance"`
	Token1Balance      string              `json:"token1Balance"`
	Yield24h           string              `json:"yield24h"`
	Price0             string              `json:"price0"`
	Price1             string              `json:"price1"`
	Stablecoin         string              `json:"stablecoin"`
	StablecoinDecimals int64               `json:"decimals"`
}

type TokenTopResponse {
	Code    int                  `json:"code"`
	Data    []*Token_TokenDetail `json:"data"`
	Message string               `json:"message"`
}

type PriceComparisonResult {
	ChainRequest
	Comparison string  `json:"comparison"`
	Percentage float64 `json:"percentage"`
}

type Token_Kline {
	Price     string `json:"price"`
	TimeStamp int64  `json:"timeStamp"`
}

type Token_TokenDetail {
	Address             string                `json:"address"`
	Symbol              string                `json:"symbol"`
	Name                string                `json:"name"`
	Decimals            int                   `json:"decimals"`
	Logo                string                `json:"logo"`
	Pools               []*Token_PoolDetail   `json:"pools"`
	Volume              string                `json:"volume"`
	Fdv                 string                `json:"fdv"`
	Price               string                `json:"price"`
	Kline               []*Token_Kline        `json:"kline"`
	HourPriceComparison PriceComparisonResult `json:"hourPriceComparison"`
	DayPriceComparison  PriceComparisonResult `json:"dayPriceComparison"`
}

type Token_PoolDetail {
	ID          int64           `json:"id"`
	Address     string          `json:"address"`
	FeeTier     int             `json:"feeTier"`
	Liquidity   string          `json:"liquidity"`
	Token0      Token_TokenInfo `json:"token0"`
	Token1      Token_TokenInfo `json:"token1"`
	Token0Price string          `json:"token0Price"`
	Token1Price string          `json:"token1Price"`
	Tick        string          `json:"tick"`
	Volume      interface{}     `json:"volume"`
}

type Token_TokenInfo {
	Address    string      `json:"address"`
	Symbol     string      `json:"symbol"`
	Name       string      `json:"name"`
	Decimals   int         `json:"decimals"`
	Logo       string      `json:"logo"`
	Additional interface{} `json:"additional"`
}

// TokenValue represents a token amount with its price information
// - Amount: Token amount as a string with full precision integer
// - Decimals: Token decimal places
// - Price: Optional token price as a string with full precision
// - PriceDecimals: Optional decimal places for the price
//
// When Price is present, the actual token value can be calculated as:
// tokenValue = (Amount / 10^Decimals) * (Price / 10^PriceDecimals)
//
// Note: If Token_TokenPrice is not initialized, the corresponding JSON tags
// (price and priceDecimals) will not be included in the output
type Token_TokenValue {
	Amount            string `json:"amount"`
	Decimals          int    `json:"decimals"`
	*Token_TokenPrice        // Embedded field for flat JSON output
}

// TokenPrice represents price information for a token
// - Price: Token price as a string with full precision
// - Decimals: Decimal places for the price
type Token_TokenPrice {
	Price    string `json:"price"`
	Decimals int    `json:"priceDecimals"`
}

type NftDataResponse_Data {
	Amount0         float64          `json:"amount0"`
	Amount1         float64          `json:"amount1"`
	Amount0Price    float64          `json:"amount0Price"`
	Amount1Price    float64          `json:"amount1Price"`
	TickUpper       string           `json:"tickUpper"`
	TickLower       string           `json:"tickLower"`
	NftId           int              `json:"nftId"`
	UncollectedFees float64          `json:"uncollectedFees"`
	Pnl30d          string           `json:"pnl30d"`
	Owner           string           `json:"owner"`
	Pool            Token_PoolDetail `json:"pool"`
	PositionAge     int              `json:"positionAge"`
	Invested        Invested         `json:"invested"`
	Withdrawn       Withdrawn        `json:"withdrawn"`
	Fees            Fees             `json:"fees"`
	Origin          string           `json:"origin"`
	Fee             int              `json:"fee"`
	Token0          string           `json:"token0"`
	Token1          string           `json:"token1"`
	TokensOwed0     float64          `json:"tokensOwed0"`
	TokensOwed1     float64          `json:"tokensOwed1"`
	Liquidity       string           `json:"liquidity"`
	Price           string           `json:"price"`
	Token0Price     string           `json:"token0Price"`
	Token1Price     string           `json:"token1Price"`
	PoolAddress     string           `json:"poolAddress"`
	IsNative        int              `json:"isNative"`
	IsClosed        bool             `json:"isClosed"`
	Decimals0       int              `json:"decimals0"`
	Decimals1       int              `json:"decimals1"`
	Ratio           int              `json:"ratio"`
	IsNegative      bool             `json:"isNegative"`
	AmountPrice0    string           `json:"amountPrice0"`
	AmountPrice1    string           `json:"amountPrice1"`
}

type Invested {
	InvestedAmount0 string `json:"investedAmount0"`
	InvestedAmount1 string `json:"investedAmount1"`
}

type Withdrawn {
	WithdrawnAmount0 string `json:"withdrawnAmount0"`
	WithdrawnAmount1 string `json:"withdrawnAmount1"`
}

type Fees {
	FeeAmount0 string `json:"feeAmount0"`
	FeeAmount1 string `json:"feeAmount1"`
}

type AggregatedAmounts {
	TotalAmount0 float64 `json:"totalAmount0"`
	TotalAmount1 float64 `json:"totalAmount1"`
}

type PositionRequest {
	ChainRequest
	TokenId int64 `path:"tokenId"`
}

type PositionResponse {
	Position *Position `json:"position"`
}

type SwapEventRequest {
	ChainRequest
	Order       string `form:"order,default=ASC"` // Sorting order, default is "ASC"
	Page        int64  `form:"page,default=1"`    // Current page number, default is 1
	Take        int64  `form:"take,default=10"`   // Number of items per page, default is 10
	Address     string `form:"address,optional"`
	PoolAddress string `form:"poolAddress,optional"`
	Token       string `form:"token,optional"`
	Token0      string `form:"token0,optional"`
	Token1      string `form:"token1,optional"`
}

type SwapEvent {
	ID        int64            `json:"id"`
	Address   string           `json:"address"`
	Token0    Token_TokenInfo  `json:"token0"`
	Token1    Token_TokenInfo  `json:"token1"`
	Pool      Token_PoolDetail `json:"pool"`
	Hash      string           `json:"hash"`
	Amount0   float64          `json:"amount0"`
	Amount1   float64          `json:"amount1"`
	Usd       float64          `json:"usd"`
	CreatedAt string           `json:"createdAt"`
}

type SwapEventResponse {
	Code    int             `json:"code"`
	Data    []*SwapEvent    `json:"data"`
	Meta    *PaginationMeta `json:"meta"`
	Message string          `json:"message"`
}

type SwapVolumeRequest {
	ChainRequest
	PoolAddress string `form:"poolAddress"` // Pool address
