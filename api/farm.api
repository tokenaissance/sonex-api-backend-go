syntax = "v1"

/*
Farm Module
*/
// incentive list id
type FarmIncentivesRequest {
	ChainRequest
	UserAddress string `form:"userAddress,optional"`                  // 用户地址
	Status      string `form:"status,optional,options=active|closed"` // 运行状态
	OrderBy     string `form:"orderBy,optional,options=hot|apr"`      // 排序字段
	KeyWord     string `form:"keyWord,optional"`
	StakedOnly  bool   `form:"stakedOnly"`
}

type FarmIncentivesResponse {
	USD   FarmIncentivesResponse_Token  `json:"usd"`
	List  []FarmIncentivesResponse_Data `json:"list"`
	Total int64                         `json:"total"`
}

type FarmIncentivesResponse_Token {
	Address  string `json:"sddress"`
	Symbol   string `json:"symbol"`
	Decimals int64  `json:"decimals"`
	Price    string `json:"price"`
}

type FarmIncentivesResponse_Data {
	PageRequest
	IncentiveId         int64  `json:"incentiveId"`
	PoolAddress         string `json:"poolAddress"` // 池子合约地址
	FeeRatio            string `json:"feeRatio"`    // 池子手续费率
	RewardTokenAddress  string `json:"rewardTokenAddress"`
	RewardTokenSymbol   string `json:"rewardTokensymbol"`
	RewardTokenDecimals int64  `json:"rewardTokenDecimals"`
	RewardTokenPrice    string `json:"rewardTokenPrice"`
	Token0Address       string `json:"token0Address"`  // token0合约地址
	Token0Symbol        string `json:"token0symbol"`   // token0代币符号
	Token0Decimals      int64  `json:"token0Decimals"` // token0精度
	Token0Price         string `json:"token0Price"`    // token0价格
	Token1Address       string `json:"token1Address"`  // token1合约地址
	Token1Symbol        string `json:"token1Symbol"`   // token1代币符号
	Token1Decimals      int64  `json:"token1Decimals"` // token1精度
	Token1Price         string `json:"token1Price"`    // token1价格
	Liquidity           string `json:"liquidity"`      // 池子的流动性
	LiquidityUSD        string `json:"liquidityUsd"`   // 池子的流动性价值（USD）
	APR                 string `json:"apr"`            // 年化收益率
	JoinNum             int64  `json:"joinNum"`        // 参与人数
	Status              string `json:"status"`         // 运行状态（active or closed）
	StartAt             int64  `json:"startAt"`        // position 开始的时间
	Balance             int64  `json:"balance"`
	Staked              int64  `json:"staked"`
	Earned              string `json:"earned"`
	Weight              string `json:"weight"`  // 该 incentiveid 的 Weight
	TotalWeight         string `json:"totalWeight"` // 所有incentiveid池子的总权重，TotalWeight
	Positions           []*Position  `json:"-"` 

	TotalClaimableFeesUSD string `json:"totalClaimableFeesUsd"` // 用户未领取的手续费的价值
	TotalClaimedFeesUSD string `json:"totalClaimedFeesUSD"`     // 用户已经领取的手续的价值

	LiquidityUSDFloat64        	 float64 `json:"-"`   // 池子的流动性价值（USD）
	TotalClaimableFeesUSDFloat64 float64 `json:"-"` // 用户未领取的手续费的价值
	TotalClaimedFeesUSDFloat64 	 float64 `json:"-"`     // 用户已经领取的手续的价值

	ListStakedPosition []StakePositionsInfoResponse_Data     `json:"-"`
}

type DashboardIncentiveWithStakedUsd {
	TotalStakedLpUsd string `json:"totalStakedLpUsd"`  // 总质押的LP 的USD
	TotalStakedLpUsdFloat64 float64 `json:"totalStakedLpUsdFloat64"` // 总质押的LP 的float64
	TotalRevenueUsd string `json:"totalRevenueUsd"`	 // 总质押的收益
	TotalRevenueUsdFloat64 float64 `json:"totalRevenueUsdFloat64"`	
	DashboardIncentives []DashboardIncentiveInfo `json:"dashboardIncentives"`
}

type DashboardIncentiveInfo {
	IncentiveId         int64  `json:"incentiveId"`
	FeeRatio            string `json:"feeRatio"`   
	Token0Symbol        string `json:"token0symbol"`   // token0代币符号
	Token0Logo          string `json:"token0_logo"`
	Token1Symbol        string `json:"token1Symbol"`   // token1代币符号
	Token1Logo          string  `json:"token1_logo"`

	Staked              int64  `json:"staked"`   //  正在质押的个数
	StakedUsd           string `json:"StakedUsd"` // 质押的 LP 的 USD

	TotalClaimableFeesUSD string `json:"totalClaimableFeesUsd"` // 用户未领取的手续费的价值
	TotalClaimableFeesUSDFloat64 float64 `json:"totalClaimableFeesUSDFloat64"` // 用户未领取的手续费的价值

	RevenueString string `json:"revenueString"`     // 用户已经领取的手续的价值+用户未领取的手续费的价值
	RevenueFloat64 	 float64 `json:"revenueFloat64"`     // 用户已经领取的手续的价值++用户未领取的手续费的价值
}


type FarmUserAssetDetailRequest {
	ChainRequest
	IncentiveId string `form:"incentiveId"`      // 质押池ID
	UserAddress string `form:"userAddress"`      // 用户地址
}

// TODO 后续优化，应该是不需要 传incentiveid 全部 
// 后端一次性把 incentiveid 中所有属于useraddress 的 全部相关信息给回去
type FarmUserAssetDetailResponse {
	IncentiveId           string `form:"incentiveId"`           // 质押池ID
	TotalClaimableFees    string `json:"totalClaimableFees"`    // 用户总可领取的手续费
	TotalClaimableFeesUSD string `json:"totalClaimableFeesUsd"` // 用户总可领取的手续费的价值
	Decimals              int64  `json:"decimals"`              // 手续费token的精度
	LPStakedNum           int64  `json:"lpStakedNum"`            // 用户质押的LP token ID 数量
	LPBalance             string  `json:"lpBalance"`              // 用户的LP token ID的余额, LiquidityUSD,USD 计价
	Balance               int64  `json:"balance"`                // 用户的LP token ID的个数余额
	LiquidityUSD         string `json:"liquidityUSD"`   // 池子的流动性价值（USD）
	APR                   string    `json:"apr"`                   // 年化收益率
}

// 计算ROI 
type FarmPoolRoiRequest {
	ChainRequest
	IncentiveId string `form:"incentiveId"`                      // 质押池ID
	Amount      string `form:"amount"`                           // 金额（USD）
	Duration    int    `form:"duration,options=1|7|30|365|1825"` // 质押时长（单位：天）
}

type FarmPoolRoiResponse {
	APR                 string `json:"apr"`                 // 年化收益率
	ROI                 string `json:"ROI"`                 // 投资回报率
	Profit              string `json:"profit"`              // 投资回报金额（USD）
	PoolAddress         string `json:"poolAddress"`         // 流动性池合约地址
	RewardTokenAmount   string `json:"rewardTokenAmount"`   // 质押池的奖励代币总量
	RewardTokenPrice    string `json:"rewardTokenPrice"`    // 奖励代币价格（USD）
	RewardTokenDecimals int64  `json:"rewardTokenDecimals"` // 奖励代币的精度
	StartTime           string `json:"startTime"`           // 质押池开放时间
	EndTime             string `json:"endTime"`             // 质押池结束时间
}

// harvest 
// 显示多少可以收获的
// harvest 
type FarmPoolLiquidityRequest {
	ChainRequest
	IncentiveId string `form:"incentiveId"`      // 质押池ID
}

type FarmPoolLiquidityResponse {
	PoolAddress            string `json:"poolAddress"`           // v3流动性池合约地址
	PositionManagerAddress string `json:"postionManagerAddress"` // LP Token ID合约地址
	LiquidityUSD           string `json:"liquidityUsd"`          // 流动性池的流动性价值（USD）
	TotalToken0Amount      string `json:"totalToken0Amount"`     // token0总量
	TotalToken1Amount      string `json:"totalToken1Amount"`     // token1总量
	Token0Price            string `json:"token0Price"`           // token0价格
	Token1Price            string `json:"token1Price"`           // token1价格
	Token0Decimals         int64  `json:"token0Decimals"`        // token0精度
	Token1Decimals         int64  `json:"token1Decimals"`        // token1精度
	Token0Symbol           string `json:"token0Symbol"`          // token0符号
	Token1Symbol           string `json:"token1Symbol"`          // token0符号
}


// 计算有userAddress 在这个里面有多少可以Staked 的
type FarmStakeRequest {
	ChainRequest
	UserAddress string `form:"userAddress"`                  // 用户地址
	PoolAddress string `form:"poolAddress"`
	IncentiveId string `form:"incentiveId"`      // 质押池ID
	PageSize    int64  `form:"pageSize,default=3"`
	PageIndex   int64  `form:"pageIndex,default=1"`
}


// LIST :默认长度为3 个
type FarmStakeResponse {
	Total          int64  `json:"total"` 
	IncentiveId     string `form:"incentiveId"`      // 质押池ID
	FeeTier        int64  `json:"feeTier"`
	Token0Decimal  int64  `json:"token0Decimal"`
	Token1Decimal  int64  `json:"token1Decimal"`
	SqrtPrice96    string `json:"sqrtPrice96"`
	Token0Symbol   string `json:"token0Symbol"`
	Token1Symbol   string `json:"token1Symbol"`
	List []StakePositionsInfoResponse_Data     `json:"list"`
}

// PageSize :默认长度为3 个
type StakePositionsInfoResponse_Data {
	PositionId   int64 `json:"positionId"` // position的tokenid
	Token0Amount string  `json:"token0Amount"`
	Token1Amount string  `json:"token1Amount"`
	TokenUsd     string `json:"tokenUsd"` 
	IsNeedApproved int64 `json:"isNeedApproved"` // IsNeedApproved: 1 ,需要approved  ; IsNeedApproved: 2 ,不需要approved  
}

// 计算有userAddress 在这个里面有多少可以Staked 的
type FarmUnstakeRequest {
	ChainRequest
	IncentiveId string `form:"incentiveId"`      // 质押池ID
	UserAddress string `form:"userAddress"`                  // 用户地址
	PoolAddress string `form:"poolAddress"`
	PageSize    int64  `form:"pageSize,default=3"`
	PageIndex   int64  `form:"pageIndex,default=1"`
}

// LIST :默认长度为3 个
type FarmUnstakeResponse {
	IncentiveId    string `form:"incentiveId"`      // 质押池ID
	Total          int64  `json:"total"` 
	FeeTier        int64  `json:"feeTier"`
	Token0Decimal  int64  `json:"token0Decimal"`
	Token1Decimal  int64  `json:"token1Decimal"`
	SqrtPrice96    string `json:"sqrtPrice96"`
	Token0Symbol   string `json:"token0Symbol"`
	Token1Symbol   string `json:"token1Symbol"`
	List []UnstakePositionsInfoResponse_Data     `json:"list"`
}

// PageSize :默认长度为3 个
type UnstakePositionsInfoResponse_Data {
	PositionId   int64    `json:"positionId"`
	Token0Amount string   `json:"token0Amount"`
	Token1Amount string   `json:"token1Amount"`
	TokenUsd     string   `json:"tokenUsd"` 
}

@server (
	prefix: /farm
	group:  farm
)
service sonex_api_backend_go {
	@doc "Farm incentive list"
	@handler FarmIncentivesHandler
	get /incentives (FarmIncentivesRequest) returns (FarmIncentivesResponse)

	@doc "Farm pool liquidity"
	@handler FarmPoolLiquidity
	get /pool/liquidity (FarmPoolLiquidityRequest) returns (FarmPoolLiquidityResponse)

	@doc "Farm Stake positions"
	@handler FarmStakePosition
	get /pool/stakeposition (FarmStakeRequest) returns (FarmStakeResponse)

	@doc "Farm untake positions"
	@handler FarmUnstakePosition
	get /pool/unstakeposition (FarmUnstakeRequest) returns (FarmUnstakeResponse)

	@doc "Farm user's asset detail in pool"
	@handler FarmUserAssetDetailHandler
	get /user/asset/detail (FarmUserAssetDetailRequest) returns (FarmUserAssetDetailResponse)

	@doc "Farm pool roi"
	@handler FarmPoolRoiHandler
	get /pool/roi (FarmPoolRoiRequest) returns (FarmPoolRoiResponse)

}